{
  "name": "recalllab",
  "private": true,
  "version": "0.6.1-alpha.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "scripts": {
    "local": "bash ./打开RecallLab.sh",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run fixtures:check && npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "test:serve": "vite --mode test --host 127.0.0.1 --port 5174 --strictPort",
    "fixtures": "node scripts/generate-fixtures.mjs && node scripts/generate-import-fixtures.mjs && node scripts/generate-pdf-fixtures.mjs && node scripts/generate-chinese-pdf-fixtures.mjs && node scripts/generate-scan-fixtures.mjs",
    "fixtures:check": "node scripts/generate-fixtures.mjs --check && node scripts/generate-import-fixtures.mjs --check && node scripts/generate-pdf-fixtures.mjs --check && node scripts/generate-chinese-pdf-fixtures.mjs --check && node scripts/generate-scan-fixtures.mjs --check && node scripts/generate-reference-corpus.mjs --check && node scripts/summarize-ai-v052.mjs --check && node scripts/summarize-product-v061.mjs --check",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:summary": "node scripts/test-summary.mjs",
    "test:production": "playwright test --config playwright.production.config.ts",
    "test:firefox": "playwright test --config playwright.firefox.config.ts",
    "metrics:product": "node scripts/summarize-product-v061.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "dexie": "4.2.1",
    "dexie-react-hooks": "4.2.0",
    "lucide-react": "0.468.0",
    "papaparse": "5.7.0",
    "pdfjs-dist": "5.5.207",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tesseract.js": "7.0.0",
    "ts-fsrs": "5.4.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/papaparse": "5.3.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "5.1.4",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.4",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "7.3.7",
    "vite-plugin-static-copy": "3.4.0",
    "vitest": "4.1.12"
  }
}
